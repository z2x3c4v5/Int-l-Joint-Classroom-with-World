rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Path: presentations/{sessionCode}/{objectId}/{filename}
    match /presentations/{sessionCode}/{objectId}/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && sessionCode.matches('[A-Z0-9-]{3,16}')
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && firestore.get(/databases/(default)/documents/sessions/$(sessionCode)).data.active == true;
    }
  }
}
