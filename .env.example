# Copy this file to ".env" for local dev, and add the same values as
# Environment Variables in Vercel (Project → Settings → Environment Variables).
# These are the FRONTEND values only — they are safe to expose to the browser.

# ── Firebase web config ──────────────────────────────────────────────
# Firebase console → Project settings (gear) → General →
#   "Your apps" → Web app → SDK setup and configuration → Config
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FB_PROJECT_ID=your-project-id
VITE_FB_APP_ID=

# Region your Cloud Functions run in (leave as-is unless you changed it).
VITE_FB_REGION=us-central1

# ── LiveKit Cloud ────────────────────────────────────────────────────
# cloud.livekit.io → your project → Settings → the "wss://..." Project URL
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# NOTE: The secret server-side keys (LiveKit API key/secret, OpenAI key,
# teacher passcode) are NOT set here. They are set as Firebase Functions
# secrets — see SETUP.md step 5.
