rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sessions are read-only to clients. Only the passcode-protected
    // Cloud Functions (Admin SDK) create/update them.
    match /sessions/{code} {
      allow read: if request.auth != null;
      allow write: if false;

      // Presentation objects within a session.
      match /objects/{objectId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && get(/databases/$(database)/documents/sessions/$(code)).data.active == true
          && request.resource.data.status == 'pending'
          && request.resource.data.ownerUid == request.auth.uid
          && (
            (request.resource.data.type == 'image'
              && request.resource.data.imageUrl is string)
            || (request.resource.data.type == 'slides'
              && request.resource.data.slidesUrl is string
              && request.resource.data.slidesUrl.matches('https://docs.google.com/presentation/.*'))
          );
        allow delete: if false;
      }

      // Match-mode queue: each student writes their own waiting entry, the
      // matchmaker Function flips status to "paired" + adds pairId.
      match /queue/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid
          && get(/databases/$(database)/documents/sessions/$(code)).data.active == true
          && request.resource.data.status == 'waiting'
          && request.resource.data.name is string
          && (request.resource.data.country == 'KR' || request.resource.data.country == 'INTL');
        // Only the Function may flip waiting → paired.
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // 1:1 pair rooms produced by the matchmaker. Members read-only.
      match /pairs/{pairId} {
        allow read: if request.auth != null;
        allow write: if false;

        // AI facilitator feed — Function appends, members read.
        match /facilitatorMessages/{msgId} {
          allow read: if request.auth != null;
          allow write: if false;
        }
      }
    }
  }
}
